   "id": "39581441-4ad4-4948-9ab1-1b1e6cabf945",
   "metadata": {},
   "source": [
    "Средствами numpy создать матрицу NxN в каждой строке которой значения меняются от 0 до N/2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "1384afc9-db1a-4c1b-bf56-91fe35fc8f16",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[0.         0.66666667 1.33333333 2.        ]\n",
      " [0.         0.66666667 1.33333333 2.        ]\n",
      " [0.         0.66666667 1.33333333 2.        ]\n",
      " [0.         0.66666667 1.33333333 2.        ]]\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "N = 4\n",
    "\n",
    "row = np.linspace(0, N//2, N)\n",
    "matrix = np.tile(row, (N, 1))\n",
    "\n",
    "print(matrix)"
   ]
  }
 ],
